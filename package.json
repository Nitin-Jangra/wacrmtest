{
  "name": "gym-whatsapp-helpdesk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Gym WhatsApp Helpdesk and Mock CRM Staging Foundation",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"mock-crm,api\" -c \"magenta,cyan\" \"npm run dev:mock-crm\" \"npm run dev:api\"",
    "dev:api": "npm run dev --workspace=@gym-helpdesk/api",
    "dev:mock-crm": "npm run dev --workspace=@gym-helpdesk/mock-crm-api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:security": "vitest run tests/security",
    "test:watch": "vitest",
    "clean": "rimraf apps/*/dist packages/*/dist coverage"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.6"
  }
}
