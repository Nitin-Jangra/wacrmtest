# ==============================================================================
# Environment Configuration Template
# Gym WhatsApp Helpdesk & Mock CRM Monorepo
# DO NOT COMMIT REAL SECRETS IN THIS FILE OR TO VERSION CONTROL
# ==============================================================================

# Application Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Main Helpdesk API Server Port
API_PORT=4000

# Mock CRM API Server Port
MOCK_CRM_PORT=4001

# Restrictive CORS Allowlist (comma-separated origins)
CORS_ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:4001

# Development Mock Authentication Flag
# CRITICAL: Must be false or omitted in production. App will refuse to start if true in production.
MOCK_AUTH_ENABLED=true

# CRM Integration Adapter Mode ('mock' | 'http')
# - 'mock': In-process mock CRM adapter using internal fixture repository
# - 'http': Networked HTTP adapter making requests to Mock CRM API (or real CRM in future)
CRM_ADAPTER=http

# Mock CRM API Base URL (used when CRM_ADAPTER=http)
MOCK_CRM_BASE_URL=http://localhost:4001

# Internal Service-to-Service Token for CRM API verification
MOCK_CRM_SERVICE_TOKEN=dev-service-token-secret-change-in-prod

# ==============================================================================
# Supabase PostgreSQL Staging Configuration
# ==============================================================================
# Supabase Project HTTPS Endpoint
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Service Role Key (Server-side admin key with RLS bypass capability)
SUPABASE_SERVICE_ROLE_KEY=eyJh...your-service-role-key

# Supabase Anonymous Client Key (Public access key)
SUPABASE_ANON_KEY=eyJh...your-anon-key

# Direct PostgreSQL Connection URL (for psql migrations / seeding)
DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# ==============================================================================
# Meta WhatsApp Cloud API Configuration
# ==============================================================================
# Provider mode ('mock' | 'cloud_api')
WHATSAPP_PROVIDER=mock

# Meta Permanent or System User Access Token
WHATSAPP_ACCESS_TOKEN=your-meta-access-token

# Meta Phone Number ID (Sender Channel)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Meta WhatsApp Business Account (WABA) ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# Meta Graph API Version (e.g. v21.0)
WHATSAPP_API_VERSION=v21.0

# Secret token configured in Meta App Dashboard for webhook handshake verification
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-webhook-verify-token

# Meta App Secret used for HMAC-SHA256 signature verification (x-hub-signature-256)
WHATSAPP_APP_SECRET=your-meta-app-secret
